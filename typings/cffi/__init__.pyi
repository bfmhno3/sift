"""The slice of cffi that sift.ext.cffitok uses."""

class CData:
    def __getitem__(self, index: int) -> int: ...

class FFI:
    def cdef(self, csource: str) -> None: ...
    def dlopen(self, name: str) -> object: ...
    def new(self, cdecl: str, init: int | None = None) -> CData: ...
    def cast(self, cdecl: str, source: CData) -> CData: ...
    def unpack(self, cdata: CData, length: int) -> list[int]: ...
